# Frontend — Producción

NEXT_PUBLIC_APP_URL=https://tudominio.com
# IMPORTANTE: debe incluir el sufijo /api (el baseURL de axios lo asume)
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api

# El navegador llama al API directamente (no hay proxy en Next). Frontend y API
# deben compartir dominio registrable (app.tudominio.com + api.tudominio.com):
# el refresh token viaja en una cookie HttpOnly del API.

# Sentry (opcional)
# SENTRY_DSN: errores del servidor de Next (runtime).
# NEXT_PUBLIC_SENTRY_DSN: errores del navegador; se hornea al compilar, así que
# debe existir en el entorno de BUILD (Vercel: Environment Variables; Docker: --build-arg).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (opcional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX