# ============================================================
# PRODUCCIÓN — Template de variables
# Copia como .env.production y rellena con tus valores.
#
# docker-compose.prod.yml pasa este archivo entero al backend (env_file).
# En Railway/Vercel, copia cada variable a Variables/Secrets del servicio.
#
# [OBLIGATORIA]  el backend NO arranca sin ella (backend/src/config/entorno.ts)
# [SI STRIPE]    obligatoria si STRIPE_SECRET_KEY está definida
# [OPCIONAL]     sin ella esa función queda desactivada
# ============================================================

# NODE & API
NODE_ENV=production
PORT=3001
# [OBLIGATORIA] Origen(es) del frontend para CORS, separados por comas
FRONTEND_URL=https://tudominio.com
# URL pública del backend (solo la usa el frontend al compilar)
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api

# AUTENTICACIÓN JWT — [OBLIGATORIAS] mínimo 32 caracteres aleatorios
# Genera cada una con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookie HttpOnly del refresh token. Requisito: frontend y API bajo el mismo
# dominio registrable (app.tudominio.com + api.tudominio.com); con dominios de
# proveedores distintos el navegador la bloquea y la sesión caduca a los 15 min.
# REFRESH_COOKIE_SAMESITE=lax        # lax (por defecto) | strict | none
# COOKIE_DOMAIN=                     # vacío = solo el host del API (recomendado)

# Panel de administración: verificación en dos pasos — [OBLIGATORIAS]
# Genera cada una con: openssl rand -hex 32
# ADMIN_TOTP_KEY cifra los secretos TOTP en la base; si se pierde, todos los
# admins tendrán que volver a enrolarse.
ADMIN_TOTP_KEY=
ADMIN_JWT_SECRET=

# BASE DE DATOS (PostgreSQL con SSL)
# verify-full y no require: node-postgres 8 trata require como verify-full, pero
# en su próxima versión mayor require dejará de verificar el certificado.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/bi0a100?sslmode=verify-full
# Aplica las migraciones pendientes al arrancar. La API y el worker lo hacen bajo
# un candado de Postgres (config/migracionesAlArrancar.ts): migra solo uno.
# En Railway ya corren en preDeployCommand y aquí no queda nada pendiente.
TYPEORM_MIGRATIONS_RUN=true
# [OPCIONAL] SSL explícito para proveedores que no lo negocian por la URL
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# REDIS (gestionado con TLS: rediss://)
REDIS_URL=rediss://:token@xxxxx.upstash.io:xxxxx

# ALMACENAMIENTO DE ARCHIVOS (S3 o compatible: R2, Spaces…) — [OBLIGATORIAS]
# Logos, imágenes y vídeos de producto, grabaciones de ventas y cédulas de expertos.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=bi0a100-prod
# URL pública con la que se sirven los objetos (bucket, CDN o dominio propio), sin "/" final
AWS_BUCKET_URL_BASE=https://bi0a100-prod.s3.us-east-1.amazonaws.com

# RESPALDOS DE LA BASE — van en el SERVICIO DE RESPALDO (scripts/respaldo), no en la API.
# Guía completa: docs/deployment/RESPALDOS.md. Con otras llaves de AWS: un usuario que solo
# puede escribir (s3:PutObject) en un bucket aparte.
# RESPALDO_BUCKET=bi0a100-respaldos
# RESPALDO_AGE_DESTINATARIO=age1…        # llave PÚBLICA; la privada nunca va al servidor
# RESPALDO_AVISO_URL=                     # opcional: webhook si el respaldo falla

# STRIPE (Pagos) — [OPCIONAL] sin clave, la facturación responde 503
STRIPE_SECRET_KEY=
# [SI STRIPE] sin ella se rechazan todos los webhooks y ningún pago activa su plan
STRIPE_WEBHOOK_SECRET=

# Planes del SaaS: Price ID por ciclo + Product ID. [SI STRIPE]
# Un plan sin precio no se ofrece. Un plan CON precio exige su STRIPE_PRODUCT_*:
# sin él, quien lo paga queda en Gratis.
STRIPE_PRICE_PRO_MENSUAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_PRO_PLUS_MENSUAL=
STRIPE_PRICE_PRO_PLUS_ANUAL=
STRIPE_PRODUCT_PRO_PLUS=
STRIPE_PRICE_BUSINESS_MENSUAL=
STRIPE_PRICE_BUSINESS_ANUAL=
STRIPE_PRODUCT_BUSINESS=
STRIPE_PRICE_ENTERPRISE_MENSUAL=
STRIPE_PRICE_ENTERPRISE_ANUAL=
STRIPE_PRODUCT_ENTERPRISE=

# Patrocinios de la red de expertos (suscripción). [OPCIONAL]
# STRIPE_PRICE_PATROCINIO sirve de precio común si falta el de una categoría.
STRIPE_PRICE_PATROCINIO=
STRIPE_PRICE_PATROCINIO_LEGAL=
STRIPE_PRICE_PATROCINIO_MARKETING=
STRIPE_PRICE_PATROCINIO_VENTAS=
# Impulsos de la red (pago único por día), en MXN. Por defecto 39 y 99.
# IMPULSO_TARIFA_CIUDAD_MXN=39
# IMPULSO_TARIFA_NACIONAL_MXN=99

# EMAIL TRANSACCIONAL — Resend o SMTP [OPCIONAL]
RESEND_API_KEY=
# [SI EMAIL] Base de los enlaces de los correos (restablecer contraseña, avisos).
# Sin ella los enlaces apuntarían a http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://tudominio.com
EMAIL_FROM=BI 0 A 100 <no-reply@tudominio.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ANTHROPIC (Análisis IA) — [OBLIGATORIA] formato sk-ant-…
ANTHROPIC_API_KEY=

# TRANSCRIPCIÓN DE VOZ — [OPCIONAL] sin clave la ruta responde 503
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# DATOS EXTERNOS — [OPCIONAL]
SERPAPI_KEY=
INEGI_TOKEN=

# WORKER DE ANÁLISIS
# En docker-compose.prod.yml la API va con RUN_WORKER=false y los trabajos en el
# servicio `worker` (node dist/workers/runWorker.js). En Railway: un segundo
# servicio con el mismo repo y comando `npm run worker:prod`, y la API con RUN_WORKER=false.
# RUN_WORKER=true
# WORKER_CONCURRENCY=3

# RED Y LÍMITES
# Saltos de proxy delante del backend: 1 (Railway/Nginx), 2 (Cloudflare + proxy
# del hosting). Mal puesto, todos los usuarios sin sesión comparten un cupo.
# TRUST_PROXY=1
# Peticiones cada 15 min: por usuario con sesión y por IP sin sesión.
# RATE_LIMIT_MAX_USUARIO=1200
# RATE_LIMIT_MAX=300
# Base de datos: conexiones por instancia y tiempo máximo por consulta (ms).
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000

# GOOGLE CALENDAR (copiar citas al calendario de Google) — [OPCIONAL]
# Sin GOOGLE_CLIENT_ID el botón no aparece. Con él, las otras tres son obligatorias.
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth «Aplicación web».
# URI de redirección autorizada = GOOGLE_REDIRECT_URI (exactamente igual):
#   https://api.tudominio.com/api/integraciones/google-calendar/callback
# Scope sensible (calendar.events): para abrirlo a todos los usuarios, Google
# exige verificar la app (pantalla de consentimiento). Tarda semanas.
# GOOGLE_TOKENS_KEY cifra los tokens guardados: openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKENS_KEY=
# Entrar y registrarse con Google (mismo cliente OAuth). Opcional: sin ella el
# botón «Continuar con Google» no aparece. Regístrala también en Google Cloud
# como URI de redirección autorizada: https://api.tudominio.com/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=

# SENTRY (Monitoreo de errores) — [OPCIONAL]
# SENTRY_DSN: backend y servidor de Next. NEXT_PUBLIC_SENTRY_DSN: navegador
# (se hornea al compilar el frontend; puede ser el mismo DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# OBSERVABILIDAD Y MÉTRICAS
# Sin token, /metrics responde 404 en producción. Mínimo 32 caracteres: openssl rand -hex 32
# Prometheus lo lee de un archivo: printf '%s' "$METRICS_TOKEN" > prometheus/metrics_token
METRICS_TOKEN=

# SUBIDAS DE VÍDEO/AUDIO en memoria a la vez (todo el proceso). Por usuario: 2.
# MAX_SUBIDAS_PESADAS_SIMULTANEAS=8
