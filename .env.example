# ============================================================
# BI 0 A 100 — Variables de entorno
# Copia este archivo como .env y reemplaza los valores
# ============================================================

# JWT — Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_genera_clave_aleatoria_64_chars
JWT_REFRESH_SECRET=CAMBIAR_genera_clave_refresh_aleatoria_64_chars

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bi0a100

# Redis (el codigo lee REDIS_HOST/REDIS_PORT o REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379

# URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# TypeORM (IMPORTANTE: false para no destruir indices ni FK de migraciones)
TYPEORM_SYNCHRONIZE=false

# APIs externas (completar cuando estén disponibles)
ANTHROPIC_API_KEY=sk-ant-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SERP_API_KEY=
NANO_BANANA_API_KEY=

# Transcripción de voz (OPCIONAL). Sin clave, POST /api/ventas/transcribir
# responde 503 y el resto de la app funciona igual.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Métricas y observabilidad (OPCIONAL en desarrollo)
METRICS_TOKEN=
