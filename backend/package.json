{
    "name": "bi0a100-backend",
    "version": "1.0.0",
    "description": "BI 0 A 100 - Business Intelligence SaaS",
    "main": "dist/app.js",
    "engines": {
        "node": ">=20.9.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "ts-node-dev --respawn src/app.ts",
        "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.build.json --outDir dist",
        "start": "node dist/app.js",
        "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
        "typeorm": "ts-node --transpile-only ./node_modules/typeorm/cli.js -d src/config/cli-datasource.ts",
        "migration:show": "npm run typeorm -- migration:show",
        "migration:run": "npm run typeorm -- migration:run",
        "migration:revert": "npm run typeorm -- migration:revert",
        "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/cli-datasource.js",
        "migration:show:prod": "node ./node_modules/typeorm/cli.js migration:show -d dist/config/cli-datasource.js",
        "test": "jest --runInBand",
        "test:coverage": "jest --coverage --runInBand",
        "lint": "eslint src --ext .ts",
        "seed:demo": "ts-node --transpile-only src/scripts/seed-demo-completo.ts",
        "seed:alertas": "ts-node --transpile-only src/scripts/seed-alertas-demo.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.125.0",
        "@aws-sdk/client-s3": "^3.1117.0",
        "@sentry/node": "^7.100.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.81.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^7.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.0",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.5",
        "openai": "^4.1.0",
        "otplib": "^12.0.1",
        "pg": "^8.11.0",
        "qrcode": "^1.5.4",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.1.13",
        "resend": "^3.0.0",
        "stripe": "^14.0.0",
        "typeorm": "^0.3.17",
        "uuid": "^9.0.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/jest": "^29.5.8",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.9.0",
        "@types/nodemailer": "^8.0.1",
        "@types/qrcode": "^1.5.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^6.8.1",
        "@typescript-eslint/parser": "^6.8.1",
        "eslint": "^8.52.0",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2"
    },
    "overrides": {
        "qs": "^6.16.0"
    }
}
