# JWT Secrets — Min 32 chars for production, random string
# IMPORTANTE: Generar nuevos valores para producción
JWT_SECRET=your_jwt_secret_here_min_32_chars_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars_random_string
# Panel de administración: verificación en dos pasos.
# OBLIGATORIAS en producción (sin ellas el panel no abre). En desarrollo, si
# faltan, se derivan de JWT_SECRET. Genera cada una con: openssl rand -hex 32
# ADMIN_TOTP_KEY cifra los secretos TOTP en la base; si se pierde, todos los
# admins tendrán que volver a enrolarse.
ADMIN_TOTP_KEY=
ADMIN_JWT_SECRET=

# Node Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgres://username:password@localhost:5432/bi0a100
# Redis: REDIS_URL (redis:// o rediss://) tiene prioridad; si no, REDIS_HOST/REDIS_PORT
REDIS_HOST=localhost
REDIS_PORT=6379

# TypeORM (dev)
# Mantener en false: synchronize borra los indices y FK creados por las
# migraciones con nombre explicito (idx_*, uq_*, fk_*). Aplicar cambios de
# esquema con `npm run migration:run`.
TYPEORM_SYNCHRONIZE=false

# External APIs (Dejar vacío si no se usa)
# La lista completa de producción, con qué es obligatorio, está en
# ../.env.production.template. En producción el backend no arranca si falta
# algo imprescindible (src/config/entorno.ts).
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=
SENTRY_DSN=
# Base de los enlaces de los correos (restablecer contraseña, avisos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Almacenamiento de archivos (S3 o compatible). En desarrollo, sin estas
# variables, los archivos se guardan en backend/uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# URL pública de los objetos, sin "/" final
AWS_BUCKET_URL_BASE=

# DENUE (INEGI) - censo oficial MX (opcional)
DENUE_TOKEN=

# Stripe (opcional en desarrollo). Precios y productos por plan:
# STRIPE_PRICE_<PLAN>_MENSUAL / _ANUAL y STRIPE_PRODUCT_<PLAN>, con
# PLAN = PRO | PRO_PLUS | BUSINESS | ENTERPRISE (ver .env.production.template)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=